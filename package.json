{
  "name": "vigilant-web",
  "description": "Continuous web health, performance, and accessibility quality gate pipeline.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && htmlhint index.html",
    "preview": "vite preview",
    "audit:check": "lhci autorun --config=.vigilantrc.json",
    "check:size": "size-limit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/preset-app": "^11.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "size-limit": "^11.2.0",
    "vite": "^8.3.0"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "250 KB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "50 KB"
    }
  ]
}
